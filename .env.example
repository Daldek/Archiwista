# The one variable the application reads (DEV-13.1, DEV-18.3). The others below only
# select the stores of the opt-in tests; each of those is a directory.

# Level of the log on standard error: debug, info, warning (default) or error.
# `--verbose` (debug) and `--quiet` (error) of a command win over it; job and
# render processes read it too.
ARCHIWISTA_LOG_LEVEL=

# A real Kartograf store for the tests marked `live`.
ARCHIWISTA_LIVE_STORE=

# The large synthetic store of the `perf` measurements (tests/fixtures/make_store.py)
# and the same store on a real SMB share with a local work folder for the `smb` runs.
ARCHIWISTA_PERF_STORE=
ARCHIWISTA_SMB_STORE=
ARCHIWISTA_SMB_WORK=

# Folder for the screenshots of the interface tests; none are written when unset.
ARCHIWISTA_SCREENSHOTS=
