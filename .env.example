# The variables the application reads (DEV-13.1, DEV-18.3). The others below only
# select the stores of the opt-in tests; each of those is a directory.

# Level of the log on standard error: debug, info, warning (default) or error.
# `--verbose` (debug) and `--quiet` (error) of a command win over it; job processes
# read it for the job's own log. `archiwista serve` follows it until it serves; its
# logs in <state_dir>/archiwista/logs keep warnings and errors whatever the level.
ARCHIWISTA_LOG_LEVEL=

# The settings file the Nogat tools share, when it is not ~/.config/nogat/nogat.toml:
# Archiwista reads data_dir, cache_dir, state_dir (the server's logs), lang and gui
# of it (A-ADR-053, A-ADR-057). A file it names
# must exist; the NOGAT_<KEY> variables themselves are not read.
NOGAT_CONFIG=

# A real Kartograf store for the tests marked `live`: its root, the directory that holds
# kartograf-store.json. A store written by an earlier Kartograf has no marker; run
# `kartograf store init --root <path>` once before the tests read it.
ARCHIWISTA_LIVE_STORE=

# The large synthetic store of the `perf` measurements (tests/fixtures/make_store.py)
# and the same store on a real SMB share with a local work folder for the `smb` runs.
# The generator writes the marker first; a store it generated earlier has none, and
# `kartograf store init` refuses its deliberate defects: generate it again.
ARCHIWISTA_PERF_STORE=
ARCHIWISTA_SMB_STORE=
ARCHIWISTA_SMB_WORK=

# Folder for the screenshots of the interface tests; none are written when unset.
ARCHIWISTA_SCREENSHOTS=
