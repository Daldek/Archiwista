{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Hydrolog/blob/main/src/hydrolog/schemas/hydrolog-series-1.schema.json",
  "title": "hydrolog-series/1",
  "description": "A series of one variable handed to the statistics (ADR-0020), the payload of a `nogat-handoff/1` from Archiwista: the daily values of a station (`step` `day`, with `dates`), whose annual extremes the statistics find, or an annual extreme of each year (`step` `year`, with `years`, `statistic` and `year_type`). Unknown fields are refused.",
  "oneOf": [
    {
      "title": "daily values",
      "type": "object",
      "required": [
        "schema",
        "name",
        "variable",
        "unit",
        "step",
        "dates",
        "values"
      ],
      "properties": {
        "schema": {
          "const": "hydrolog-series/1"
        },
        "name": {
          "description": "What the series is, for people (the station and variable).",
          "type": "string",
          "minLength": 1
        },
        "variable": {
          "description": "The variable as its provider names it (`Q`, `H`).",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "unit": {
          "description": "Its unit (`m3/s`, `cm`).",
          "type": "string"
        },
        "values": {
          "description": "The values in the order of `dates` or `years`, the same length; `null` for a missing value.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "step": {
          "const": "day"
        },
        "dates": {
          "description": "The days, ISO 8601 (`2024-03-02`), increasing.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "title": "annual extremes",
      "type": "object",
      "required": [
        "schema",
        "name",
        "variable",
        "unit",
        "step",
        "statistic",
        "year_type",
        "years",
        "values"
      ],
      "properties": {
        "schema": {
          "const": "hydrolog-series/1"
        },
        "name": {
          "description": "What the series is, for people (the station and variable).",
          "type": "string",
          "minLength": 1
        },
        "variable": {
          "description": "The variable as its provider names it (`Q`, `H`).",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "unit": {
          "description": "Its unit (`m3/s`, `cm`).",
          "type": "string"
        },
        "values": {
          "description": "The values in the order of `dates` or `years`, the same length; `null` for a missing value.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "step": {
          "const": "year"
        },
        "statistic": {
          "description": "Which extreme of the year: `max` or `min`.",
          "enum": [
            "max",
            "min"
          ]
        },
        "year_type": {
          "description": "How the years are numbered: `hydrological` (1 Nov to 31 Oct, named after the year it ends in) or `calendar`.",
          "enum": [
            "hydrological",
            "calendar"
          ]
        },
        "years": {
          "description": "The years, increasing.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer"
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
